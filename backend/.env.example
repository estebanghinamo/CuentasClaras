APP_NAME="Cuentas Claras"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Argentina/Buenos_Aires

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Desarrollo nativo (backend fuera de Docker, ver ADR-004): 127.0.0.1 + el puerto
# expuesto al host por docker-compose.yml (solo db+redis). Si en cambio corrés el
# stack completo dockerizado (docker-compose.full.yml, CI/producción), este valor
# debe ser el nombre del servicio ("db"), no localhost - la CI lo sobreescribe sola.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cuentas_claras
DB_USERNAME=cuentas_claras
DB_PASSWORD=
DB_TIMEZONE=+00:00

# URL pública del frontend (túnel de VS Code en dev, dominio real en producción). Usada por config/cors.php.
FRONTEND_URL=http://localhost:4200

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis (100% PHP, composer) en vez de phpredis: no requiere compilar/instalar
# una extensión nativa de PHP en el host para desarrollo nativo (ver ADR-004).
# REDIS_HOST: mismo criterio que DB_HOST arriba - 127.0.0.1 para backend nativo,
# "redis" para docker-compose.full.yml.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP: generar una "contraseña de aplicación" en
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos
# activada en la cuenta de Google). MAIL_PASSWORD es esa contraseña de 16
# caracteres, NUNCA la contraseña normal de la cuenta. MAIL_SCHEME null +
# puerto 587 hace que Symfony Mailer negocie STARTTLS solo (config/mail.php
# de Laravel 12 no usa MAIL_ENCRYPTION, esa clave quedó obsoleta).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

# JSON del Service Account de Firebase (Firebase Console > Configuración del
# proyecto > Cuentas de servicio > Generar nueva clave privada), codificado
# en base64 en una sola línea. Vacío = push (FCM) deshabilitado, no rompe nada.
FIREBASE_CREDENTIALS_BASE64=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
